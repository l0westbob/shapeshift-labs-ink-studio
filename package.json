{
  "name": "@shapeshift-labs/ink-studio",
  "version": "0.1.0",
  "private": true,
  "description": "SDF sculpting and pixel-art Gaussian splats with browser and headless renderers",
  "main": "index.js",
  "browser": "./webgl.mjs",
  "files": [
    "index.js",
    "webgl.mjs",
    "src/",
    "cli/",
    "scripts/",
    "demos/",
    "lab/",
    "examples/",
    "docs/",
    "catalog.json",
    "storage-retention.json",
    "dist/ink-studio.browser.js",
    "dist/ink-studio.node.cjs",
    "dist/ink-studio.player.mjs"
  ],
  "bin": {
    "ink-studio": "cli/ink-studio.js",
    "ink-studio-mcp": "agent/mcp-server.js",
    "ink-agent": "bin/ink-agent"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "prepare": "node scripts/build.js --quiet",
    "pretest": "node scripts/build.js node",
    "test": "node --test tests/*.test.js && node cli/ink-studio.js selftest",
    "lint": "node scripts/check.js",
    "mcp": "node agent/mcp-server.js",
    "format": "prettier --write \"src/**/*.js\" \"cli/*.js\" \"demos/*.js\" \"lab/*.js\" index.js \"scripts/*.js\" \"agent/*.js\"",
    "serve": "node scripts/serve.js"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": "github:siliconjungle/shapeshift-labs-ink-studio",
  "devDependencies": {
    "three": "^0.187.0"
  },
  "peerDependencies": {
    "three": ">=0.160.0"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  }
}
